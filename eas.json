{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_UI": "v3", "EXPO_PUBLIC_API_URL": "https://REPLACE-with-staging-api-url" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_UI": "v3", "EXPO_PUBLIC_API_URL": "https://api.gomax.app" }
    }
  },
  "submit": {
    "production": { "android": { "track": "internal" } }
  }
}
